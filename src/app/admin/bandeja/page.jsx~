                                    <button className="text-[10px] bg-[#443CA3] text-white rounded-lg px-3 py-1.5 hover:bg-[#3A3391] transition">
                                        ✓ Acuerdo de pago
                                    </button>
                                </div>
                            </div>

                            {/* Messages */}
                            <div className="flex-1 px-5 py-4 flex flex-col gap-3 overflow-y-auto">
                                {selected.thread.map((msg, i) => (
                                    <div key={i}>
                                        {msg.isNew && (
                                            <div className="flex items-center gap-2 my-2">
                                                <div className="flex-1 h-px bg-gray-100"></div>
                                                <span className="text-[9px] font-semibold text-[#443CA3] bg-[#EEEDFE] px-2 py-0.5 rounded-full">
                                                    respuesta nueva
                                                </span>
                                                <div className="flex-1 h-px bg-gray-100"></div>
                                            </div>
                                        )}
                                        <div className={`flex ${msg.direction === "out" ? "justify-end" : "justify-start"}`}>
                                            <div className="max-w-[72%]">
                                                <p className={`text-[9px] text-gray-400 mb-1 ${msg.direction === "out" ? "text-right" : ""}`}>
