                                                    msg.direction === "out"
                                                        ? "bg-[#443CA3] text-white rounded-br-sm"
                                                        : "bg-gray-50 text-gray-700 border border-gray-100 rounded-bl-sm"
                                                }`}>
                                                    {msg.body}
                                                </div>
                                                <p className={`text-[9px] text-gray-300 mt-1 ${msg.direction === "out" ? "text-right" : ""}`}>
                                                    {msg.time}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>

                            {/* Reply bar */}
                            <div className="px-5 py-3 border-t border-gray-100 flex items-center gap-3">
                                <input
                                    type="text"
                                    placeholder={`Responder a ${selected.debtorName}...`}
                                    value={replyText}
                                    onChange={e => setReplyText(e.target.value)}
                                    className="flex-1 border border-gray-200 rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-[#443CA3] bg-gray-50"
                                />
                                <button className="border border-gray-200 text-gray-400 px-3 py-2.5 rounded-xl text-xs hover:bg-gray-50 transition">
                                    📎
                                </button>
                                <button className="bg-[#443CA3]/10 text-[#443CA3] border border-[#443CA3]/20 px-4 py-2.5 rounded-xl text-xs font-medium hover:bg-[#443CA3]/15 transition">
                                    ✨ Redactar con IA
                                </button>
                                <button
                                    disabled={!replyText.trim()}
                                    className="bg-[#443CA3] text-white px-4 py-2.5 rounded-xl text-xs font-medium hover:bg-[#3A3391] transition disabled:opacity-30">
                                    Enviar →
                                </button>
                            </div>
                        </>
                    )}
                </div>
            </div>
        </main>
    );
}
