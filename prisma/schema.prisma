generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id              String            @id @default(cuid())
  name            String?
  email           String?           @unique
  emailVerified   DateTime?
  image           String?
  role            String            @default("client")
  hashedPassword  String?
  // Max 12 chars, enforced at the application layer (Postgres has no
  // portable "check length" shorthand in Prisma). NOT a hard requirement
  // for SMS anymore — a missing shortName used to silently block every
  // send for that client ("Enviar a 0 destinatarios" with no way to fix
  // it from the composer). It now falls back to a name derived from the
  // client's name at send time (see deriveShortName in lib/sms/
  // templates.js), with a warning shown so the admin can set the real one.
  shortName       String?
  accounts        Account[]
  sessions        Session[]
  debtorRecords   Debtor[]
  clerkId         String            @unique
  debtorNotes     DebtorNote[]
  activityLogs    ActivityLog[]
  inboundMessages InboundMessage[]
  notificationLogs NotificationLog[] @relation("NotificationSender")
  createdTemplates Template[]
}

enum DebtorStatus {
  PENDIENTE
  EN_GESTION
  ACUERDO_DE_PAGO
  PAGADO
  ESCALADO_JUDICIAL
}

enum LogEventType {
  REMINDER_SENT
  CALL_TRIGGERED
  STATUS_CHANGED
  NOTE_ADDED
  NOTE_DELETED
  DEBTOR_CREATED
  DEBTOR_DELETED
  BULK_STATUS_CHANGED
  NOTIFICATION_SENT
  LEGAL_NOTICE_SENT
}

enum NotificationChannel {
  SMS
  EMAIL
}

// SENT = accepted by the provider (a 200 from Masiva means accepted, not
// delivered — that gap is the whole reason an earlier delivery failure went
// undiagnosed). DELIVERED is only reached via the shipped-report poll cron.
enum NotificationStatus {
  SENT
  DELIVERED
  FAILED
  INVALID_NUMBER
  OPT_OUT
}

model Debtor {
  id                 String            @id @default(uuid())
  name               String
  email              String?
  amountOwed         Float
  telephone          String?
  address            String?
  cedulaIdentidad    String?
  ruc                String?
  invoiceNumber      String?
  createdAt          DateTime          @default(now())
  user               User              @relation(fields: [userId], references: [id])
  userId             String
  availableForNotify Boolean           @default(false)
  documentUrl        String?
  status             DebtorStatus      @default(PENDIENTE)
  smsOptOut          Boolean           @default(false)
  // 8-char nanoid, not 4 — the public page at /p/[token] exposes name,
  // amount, and creditor (personal financial data under LOPDP), and a
  // 4-char token is enumerable. Generated at creation time in every
  // debtor-create code path (no DB default — see api/debtors/route.js and
  // api/debtors/upload/route.js); existing rows were backfilled by this
  // migration.
  publicToken        String            @unique
  notes              DebtorNote[]
  activityLogs       ActivityLog[]
  inboundMessages    InboundMessage[]
  smsDeliveryLogs    SmsDeliveryLog[]
  notificationLogs   NotificationLog[]

  @@index([telephone])
}

model DebtorNote {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  debtorId  String
  debtor    Debtor   @relation(fields: [debtorId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id        String       @id @default(cuid())
  event     LogEventType
  detail    String
  createdAt DateTime     @default(now())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  debtorId  String?
  debtor    Debtor?      @relation(fields: [debtorId], references: [id], onDelete: SetNull)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model NotificationSettings {
  id     String @id @default(cuid())
  hour   Int    @default(9)
  minute Int    @default(0)
}

model InboundMessage {
  id             String    @id @default(cuid())
  debtorId       String?
  debtor         Debtor?   @relation(fields: [debtorId], references: [id], onDelete: SetNull)
  clientId       String?
  client         User?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  channel        String    @default("EMAIL")
  providerId     String?
  sender         String
  subject        String?
  content        String
  receivedAt     DateTime  @default(now())
  readByClientAt DateTime?
  rawPayload     String?

  @@unique([channel, providerId])
}

model ProviderToken {
  provider  String   @id
  token     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

model SmsDeliveryLog {
  id        String   @id @default(cuid())
  debtorId  String
  debtor    Debtor   @relation(fields: [debtorId], references: [id], onDelete: Cascade)
  campaign  String
  sendDate  String
  status    String
  detail    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([debtorId, campaign, sendDate])
}

// General outgoing-notification log — SMS AND email, both the automatic
// daily reminder cron and the manual admin composer. Deliberately a
// separate model from SmsDeliveryLog rather than an extension of it:
// SmsDeliveryLog's @@unique([debtorId, campaign, sendDate]) exists only to
// dedupe the once-a-day automatic cron, which is the wrong shape for a
// manually-triggered send (an admin may legitimately resend the same
// template to the same debtor twice in one day) and doesn't fit email at
// all. See the schema-decision writeup delivered with this feature for the
// full reasoning.
model NotificationLog {
  id          String              @id @default(cuid())
  debtorId    String?
  debtor      Debtor?             @relation(fields: [debtorId], references: [id], onDelete: SetNull)
  // Who triggered it — null for the automatic reminder cron.
  userId      String?
  user        User?               @relation("NotificationSender", fields: [userId], references: [id], onDelete: SetNull)
  channel     NotificationChannel
  // Template.id for a DB-registered template, "custom" for a free-compose
  // email sent without picking a saved template, "reminder_cron" for the
  // automatic daily reminder's own message. Deliberately a plain string,
  // not a relation to Template — a template can be edited or removed
  // later without needing to touch (or cascade into) historical log rows,
  // and "custom"/"reminder_cron" were never real template rows to begin
  // with, so a required FK here would have no row to point at for those.
  template    String
  recipient   String
  status      NotificationStatus
  detail      String?
  // Masiva message/campaign id when available, for the shipped-report
  // correlation poll. Not populated for email (no equivalent yet).
  providerId  String?
  sentAt      DateTime            @default(now())
  deliveredAt DateTime?

  @@index([debtorId])
  @@index([status])
  @@index([channel])
}

enum TemplateChannel {
  SMS
  EMAIL
}

// Two genuinely different things sharing one table on purpose (channel
// discriminates), not a merge of two workflows:
//
// SMS rows REGISTER a template Masiva has already approved outside this
// app — Masiva silently drops unapproved SMS content rather than
// rejecting it, which is the failure this whole feature exists to
// prevent. Saving a row here does not request approval from anyone; the
// label on the admin form says so explicitly. `body` uses {{name}}
// {{amount}} {{shortName}} {{date}} {{url}} placeholders and is validated
// at save time (see validateSmsTemplateBody in lib/sms/templates.js):
// <=160 chars with every placeholder filled at its worst-case length,
// must survive sanitizeSmsContent unchanged (no accents/ñ), must start
// with the RECUPERA prefix. `subject` is unused for SMS (always null).
//
// EMAIL rows are free composition — subject + body, no length cap, same
// {{...}} placeholder syntax but with {{client}} (the client's own name)
// in place of SMS's {{shortName}} (there's no character budget forcing
// an abbreviation in email). Saving one does not imply Masiva or anyone
// else approved it — there is no approval process for email.
model Template {
  id          String          @id @default(cuid())
  channel     TemplateChannel
  label       String
  // EMAIL only. Always null for SMS — SMS messages have no subject line.
  subject     String?
  body        String
  // Mirrors the old hardcoded template_3's behavior (5-day legal notice):
  // requires the composer's explicit confirmation dialog before sending
  // and logs LEGAL_NOTICE_SENT instead of NOTIFICATION_SENT. Meaningful
  // for either channel, not SMS-only, so it lives on the shared model
  // rather than being bolted on as an SMS-specific field.
  restricted  Boolean         @default(false)
  // Soft-disable rather than delete — a deactivated template stays
  // available in Historial context (old NotificationLog rows reference
  // it by id) and can be reactivated without re-typing/re-validating it.
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([channel])
}
